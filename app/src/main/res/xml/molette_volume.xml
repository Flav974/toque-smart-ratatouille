<?xml version="1.0" encoding="utf-8"?>
<!-- Molette = volume dans les autres applis (MoletteVolumeService). Pas de lecture du contenu des écrans.
     Notifications : seulement le jeton de session média des lecteurs (bulle de musique de l'accueil). -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged|typeNotificationStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagRequestFilterKeyEvents"
    android:canRequestFilterKeyEvents="true"
    android:canRetrieveWindowContent="false"
    android:notificationTimeout="0"
    android:description="@string/molette_volume_description" />
